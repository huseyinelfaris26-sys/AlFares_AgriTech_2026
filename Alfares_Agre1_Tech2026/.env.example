# =====================================
# إعدادات المشروع - مثال توضيحي فقط
# انسخ هذا الملف وأسميه .env ثم املأ القيم الحقيقية
# =====================================

# قاعدة البيانات
DATABASE_URL=sqlite:///alfares_agri.db

# الواجهة الخلفية
API_BASE_URL=http://localhost:8000

# المفتاح السري (لا تضع قيمته الحقيقية هنا أبداً)
SECRET_KEY=اكتب_مفتاحك_هنا

# وضع التشغيل
DEBUG=true
